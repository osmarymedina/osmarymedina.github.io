#| echo: false
#Open broodball data file and open packages
ohecate <-read.csv("ten.gre.o.hecate.data.for.analysis.10.22.2025.csv", header=TRUE)
library(lme4)
library(languageR)
library(AICcmodavg)
library(MuMIn)
library(car)
library(ggpubr)
library(knitr)
library(fontawesome)
#| echo: false
#Load broodball number data
number<-read.csv("Broodball-number-O.hecate-Medina-Sheldon-2025.csv", header=TRUE)
tapply(number$bb.number, number$type, sum, na.rm = TRUE)
#| echo: false
ohecate <-read.csv("ten.gre.o.hecate.data.for.analysis.10.22.2025.csv", header=TRUE)
tapply(ohecate$elytra_length_cm, ohecate$type, mean, na.rm = TRUE)
#| echo: false
ohecate <-read.csv("ten.gre.o.hecate.data.for.analysis.10.22.2025.csv", header=TRUE)
tapply(ohecate$elytra_length_cm, ohecate$sex, mean, na.rm = TRUE)
#| echo: false
fa("seedling", fill = "forestgreen", height = "30px")
#| echo: true
# Examine brood ball depth with fixed effects of type and female mass and the random effect trial.
# First decide on random variable structure.
depth.a <- lmer (bb.depth ~ type + female.mass + (1|trial), data=ohecate, REML=T, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
depth.b <- lmer (bb.depth ~ type + female.mass + (type|trial), data=ohecate, REML=T, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
#| echo: false
# Check which AICc is best for low sample size
AICc(depth.a)
AICc(depth.b)
#depth.a has the lowest AICc
# Models to examine brood ball depth with fixed effects of type and female mass, and the random effects of female identification and trial.
#model1
depth.1 <- lmer (bb.depth ~ type + female.mass + (1|trial), data=ohecate, REML=FALSE, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
#model2
depth.2 <- lmer (bb.depth ~ type + (1|trial), data=ohecate, REML=FALSE, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
#model3
depth.3 <- lmer (bb.depth ~ female.mass + (1|trial), data=ohecate, REML=FALSE, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
#model4 (null)
depth.4 <- lmer (bb.depth ~ 1 + (1|trial), data=ohecate, REML=FALSE, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
Cand.models <- list(depth.1, depth.2, depth.3, depth.4)
Modnames <- paste("mod", 1:length(Cand.models), sep = " ")
aic_table <- aictab(cand.set = Cand.models, modnames = Modnames,
sort = TRUE, digits = 4, LL = TRUE)
kable(aic_table, caption = "Model selection based on AICc")
# The null model has the lowest AICc and is the best model.
#| echo: false
# Set REML=T to get summary data for the best fit model.
depth.4 <- lmer (bb.depth ~ 1 + (1|trial), data=ohecate, REML=T, control=lmerControl(optimizer="bobyqa", optCtrl=list(maxfun=2e5)))
summary(depth.4)
r.squaredGLMM(depth.4)
